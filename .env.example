# @BotFather dan olingan token
BOT_TOKEN=123456:ABC-DEF

# Adminlarning Telegram ID raqamlari (vergul bilan). ID ni @userinfobot orqali bilish mumkin
ADMIN_IDS=111111111,222222222

# --- Baza ---
# Neon (PostgreSQL) manzili. Bo'sh qoldirilsa mahalliy SQLite fayli (DB_PATH) ishlatiladi
# DATABASE_URL=postgresql://user:parol@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DB_PATH=data/bot.db

# --- Server (webhook) ---
# Render'da kerak emas: u RENDER_EXTERNAL_URL va PORT ni o'zi beradi.
# Boshqa serverda: WEBHOOK_URL=https://sizning-domen.uz
# Bo'sh bo'lsa bot polling rejimida ishlaydi (mahalliy kompyuter uchun)

TIMEZONE=Asia/Tashkent

# Adminlarga kunlik hisobot va zaxira nusxa yuboriladigan soat (0-23, mahalliy vaqt). -1 - o'chirish
DAILY_HOUR=21

# Xatolar haqida bosh adminlarga Telegram orqali xabar (0 - o'chirish)
ERROR_ALERTS=1

# Spamdan himoya: FLOOD_PERIOD soniyada FLOOD_LIMIT dan ko'p xabar - vaqtincha to'xtatish
FLOOD_LIMIT=12
FLOOD_PERIOD=6
